# Environment variables (never commit API keys)
.env

# Qdrant embedded local store (generated by scripts/ingest.py when QDRANT_LOCAL_PATH is set)
qdrant_storage/
local_storage/

# Raw inventory data files (proprietary, not for version control)
inventory_data/*
!inventory_data/.gitkeep
inventory data/

# Generated cache files (rebuild with scripts/ — too large and machine-specific for git)
enrichment_cache.json
taxonomy_cache.json
taxonomy_embeddings.json

# Per-run eval output (large per-query logs; scripts overwrite eval_results.json at repo root)
eval_results_*.json
eval2_results*.json
scripts/eval_results.json
scripts/v3_openrouter_results.json
# Locally-generated eval slices (derived from mep_eval_300_v3.csv for fast iteration)
scripts/eval_electrical.csv

# Scratch / lab directory and outputs (kept on lab-archive-* branch, not on main)
lab/
Makefile
eval_mep300*.json

# Generated diagrams (re-render via kroki.io as needed)
presentation/architecture.png
presentation/architecture.svg
presentation/qdrant_payload.png
presentation/qdrant_payload.svg
presentation/presentation_preview.html

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Streamlit cache
.streamlit/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log

# Personal reference doc
PROJECT_REFERENCE.md
CANVA_PROMPT.md
