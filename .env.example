# Copy this file to .env and fill in your values.
# .env is gitignored -- never commit real keys.

# REQUIRED -- OpenRouter API key for Gemini 2.5 Flash query classification.
# Sign up at https://openrouter.ai and create a key. There is no fallback;
# the search pipeline raises if the classifier cannot reach OpenRouter.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Qdrant Cloud (recommended for production / sharing).
# Get the cluster URL and API key from https://cloud.qdrant.io.
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# Dev override -- when set, app + ingest use an embedded local file-based
# store instead of cloud. Useful for offline iteration. Leave commented out
# in production.
# QDRANT_LOCAL_PATH=/absolute/path/to/local_storage
