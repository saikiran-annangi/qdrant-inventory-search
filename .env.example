# Copy this file to .env and fill in your values.
# Never commit the .env file -- it is listed in .gitignore.

# Required: OpenRouter API key for Gemini 2.5 Flash query classification.
# Sign up at https://openrouter.ai and create a key.
# Without this key the system falls back to the regex classifier (~55% accuracy).
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Gemini API key used during data ingestion to generate product descriptions.
# Only needed if your inventory data contains sparse or missing descriptions.
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant connection.
# Local (default): leave both commented out.
# Qdrant Cloud: set QDRANT_URL to your cluster URL and QDRANT_API_KEY to your API key.
# QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_api_key_here
